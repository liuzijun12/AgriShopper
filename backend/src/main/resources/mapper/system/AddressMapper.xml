<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youlai.boot.system.mapper.AddressMapper">

    <!-- 获取存储用户收货地址信息分页列表 -->
    <select id="getAddressPage" resultType="com.youlai.boot.system.model.vo.AddressVO">
        SELECT
                id,
                user_id,
                receiver_name,
                phone,
                province,
                city,
                district,
                detail_address,
                postal_code,
                is_default,
                is_deleted,
                create_time,
                update_time,
                delete_time
        FROM
            address
        <where>
        </where>
    </select>

</mapper>
