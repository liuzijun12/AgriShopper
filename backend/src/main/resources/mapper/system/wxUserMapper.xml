<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youlai.boot.system.mapper.wxUserMapper">

    <!-- 获取用户分页列表 -->
    <select id="getwxUserPage" resultType="com.youlai.boot.system.model.vo.wxUserVO">
        SELECT
                id,
                openid,
                unionid,
                nickname,
                avatar,
                real_name,
                phone,
                gender,
                province,
                city,
                district,
                is_manager,
                is_supermanager,
                balance,
                is_deleted,
                create_time,
                update_time,
                delete_time
        FROM
            user
        <where>
            is_deleted = 0
        </where>
    </select>

</mapper>
