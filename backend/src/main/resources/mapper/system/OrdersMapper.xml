<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youlai.boot.system.mapper.OrdersMapper">

    <!-- 获取订单分页列表 -->
    <select id="getOrdersPage" resultType="com.youlai.boot.system.model.vo.OrdersVO">
        SELECT
                id,
                user_id,
                address_snapshot,
                original_address_id,
                status,
                total_amount,
                is_deleted,
                create_time,
                update_time,
                delete_time
        FROM
            orders
        <where>
        </where>
    </select>

</mapper>
